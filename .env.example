# LLM provider. Leave every key empty to run the built-in sample extractor
# (no network, no cost). Set LLM_PROVIDER and the matching key to go live.
#   mock | openai | deepseek | google
LLM_PROVIDER=mock
LLM_MODEL=

# OpenAI — GPT-4o class, reads uploaded sketches
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek — OpenAI-compatible; deepseek-chat is text-only, so uploads are
# summarised through the architect notes rather than read directly
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Google Gemini — reads uploaded sketches
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Embedded Draw.io editor (apps/web reads this at build time).
# Defaults to the self-hosted container: docker compose up -d drawio
# Set to https://embed.diagrams.net to use the public editor instead.
VITE_DRAWIO_URL=http://localhost:8080

# CAP server
PORT=4004
CORS_ORIGIN=http://localhost:5173

# Pipeline
# langgraph | sequential
PIPELINE_ENGINE=langgraph
# true | false
REQUIRE_HUMAN_REVIEW=true

# Optional pgvector (docker compose up -d)
# DATABASE_URL=postgresql://architect:architect@localhost:5432/architect

# CORPUS_DIR=./samples/corpus
# CORPUS_DISCOVER=1
