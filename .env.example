# Leave empty for mock mode (no external LLM calls)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# CAP server
PORT=4004
CORS_ORIGIN=http://localhost:5173

# Pipeline
# mock | openai
LLM_PROVIDER=mock
# langgraph | sequential
PIPELINE_ENGINE=langgraph
# true | false
REQUIRE_HUMAN_REVIEW=true

# Optional pgvector (docker compose up -d)
# DATABASE_URL=postgresql://architect:architect@localhost:5432/architect

# CORPUS_DIR=./samples/corpus
# CORPUS_DISCOVER=1
