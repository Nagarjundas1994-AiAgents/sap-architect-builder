# Leave empty for mock mode (no external LLM calls)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Pipeline
# mock | openai
LLM_PROVIDER=mock
# langgraph | sequential
PIPELINE_ENGINE=langgraph
# true | false — pause for architect approval before Draw.io generation
REQUIRE_HUMAN_REVIEW=true

# pgvector (optional). If unset, in-memory vector store is used.
# docker compose up -d  →  then:
DATABASE_URL=postgresql://architect:architect@localhost:5432/architect

# Corpus
# CORPUS_DIR=./samples/corpus
# CORPUS_DISCOVER=1
